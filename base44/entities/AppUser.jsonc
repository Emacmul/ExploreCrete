{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 user ID"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "first_name": {
      "type": "string",
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "description": "Last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "prefer_not_to_say"
      ],
      "description": "Gender"
    },
    "password": {
      "type": "string",
      "description": "User-chosen password"
    },
    "newsletter_opted_in": {
      "type": "boolean",
      "default": true,
      "description": "Whether user has opted into newsletter emails"
    },
    "registration_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether profile setup is complete"
    },
    "membership_code": {
      "type": "string",
      "description": "The membership code entered by the user (e.g. PATH-XXXXX)"
    },
    "membership_tier": {
      "type": "string",
      "enum": [
        "wanderer",
        "explorer",
        "pathfinder",
        "wayfinder"
      ],
      "description": "Resolved membership tier based on the code prefix"
    }
  },
  "required": [
    "email",
    "first_name",
    "last_name"
  ]
}