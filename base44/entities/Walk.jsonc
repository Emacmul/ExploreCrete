{
  "name": "Walk",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Unique identifying code for the walk"
    },
    "name": {
      "type": "string",
      "description": "Name of the walk"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the walk"
    },
    "safety_notes": {
      "type": "string",
      "description": "Safety information and required equipment for this walk"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "moderate",
        "challenging",
        "difficult"
      ],
      "description": "Difficulty level"
    },
    "distance_km": {
      "type": "number",
      "description": "Total distance in kilometres"
    },
    "duration_hours": {
      "type": "number",
      "description": "Estimated duration in hours"
    },
    "elevation_gain_m": {
      "type": "number",
      "description": "Total elevation gain in metres"
    },
    "start_lat": {
      "type": "number",
      "description": "Starting point latitude"
    },
    "start_lng": {
      "type": "number",
      "description": "Starting point longitude"
    },
    "region": {
      "type": "string",
      "description": "Region of Crete"
    },
    "main_interest": {
      "type": "string",
      "description": "Main interest or theme"
    },
    "walk_category": {
      "type": "string",
      "enum": [
        "official",
        "community"
      ],
      "default": "official",
      "description": "Official Magical Crete walk or community-contributed walk"
    },
    "is_sample_walk": {
      "type": "boolean",
      "default": false,
      "description": "One of the free sample walks available to all users"
    },
    "is_member_included": {
      "type": "boolean",
      "default": false,
      "description": "Included as part of the yearly member allocation"
    },
    "price_eur": {
      "type": "number",
      "default": 15,
      "description": "Purchase price for non-members"
    },
    "contributor_name": {
      "type": "string",
      "description": "Name of community contributor if applicable"
    },
    "requires_review": {
      "type": "boolean",
      "default": false,
      "description": "Community walk awaiting approval"
    },
    "approved": {
      "type": "boolean",
      "default": true,
      "description": "Whether the walk is publicly visible"
    },
    "gpx_file_uri": {
      "type": "string",
      "description": "Private storage URI for GPX file"
    },
    "gpx_filename": {
      "type": "string",
      "description": "Original GPX filename"
    },
    "trail_path": {
      "type": "array",
      "description": "Array of coordinates forming the trail",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      }
    },
    "waypoints": {
      "type": "array",
      "description": "Important points along the trail",
      "items": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "elevation": {
            "type": "number"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "image_url": {
      "type": "string",
      "description": "Main walk image"
    },
    "announced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When members were notified"
    }
  },
  "required": [
    "code",
    "name",
    "start_lat",
    "start_lng"
  ]
}